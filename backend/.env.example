# Copy to `.env` and fill in real values. Never commit `.env`.

# --- LLM providers (OpenAI-compatible via langchain-openai) ---
# Generation only. Page embeddings always use Gemini below.
#
# Two providers are selectable at runtime via LLM_PROVIDER or POST /llm-provider.
# Set the API key for the one you intend to use.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

EURON_API_KEY=
EURON_BASE_URL=https://api.euron.one/api/v1/euri

# --- Gemini embeddings (google-genai) ---
GOOGLE_API_KEY=

# --- Paths ---
# STORAGE_DIR=
# DOCS_DIR=
# POPPLER_PATH=/opt/homebrew/bin

# --- PDF rendering (RENDER_*) ---
# RENDER_SOURCE_DPI=200
# RENDER_MEASURE_DPI=50
# RENDER_COLORSPACE=rgb
# RENDER_TRIM=true
# RENDER_CHUNK_PAGES=8
# RENDER_THREAD_COUNT=4
# RENDER_EXTRACT_TEXT=true

# --- Image normalization (IMAGE_*) ---
# IMAGE_NORMALIZE_MODE=trim_fit_uniform
# IMAGE_TARGET_W=1024
# IMAGE_TARGET_H=1408
# IMAGE_RESAMPLE=lanczos
# IMAGE_ALLOW_UPSCALE=false
# IMAGE_MAX_PIXELS=4000000
# IMAGE_JPEG_QUALITY=85
# IMAGE_JPEG_OPTIMIZE=true
# IMAGE_PAD_COLOR=ffffff

# --- Qdrant (docker compose up -d qdrant) ---
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=finance_pages
# QDRANT_TIMEOUT=60.0

# --- Gemini embeddings (EMBED_*) ---
# EMBED_MODEL=gemini-embedding-2
# EMBED_DIM=1024
# EMBED_WORKERS=4
# EMBED_RETRIES=3
# EMBED_RETRY_DELAY=2.0
# EMBED_DOCUMENT_TASK=RETRIEVAL_DOCUMENT
# EMBED_QUERY_TASK=RETRIEVAL_QUERY

# --- Generative LLM (LLM_*) ---
# Which provider generates answers and grades retrieval: groq | euron
# LLM_PROVIDER=euron

# Per-provider defaults live in app/llm/client.py (PROVIDERS). The overrides below
# apply to whichever provider is active, so leave them unset to use its defaults.
# groq  -> qwen/qwen3.8-27b for both roles (only multimodal model on most keys)
# euron -> gemini-2.5-flash for both roles
# LLM_MODEL=
# LLM_GRADER_MODEL=
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT=120.0
# LLM_MAX_RETRIES=3
# LLM_MAX_COMPLETION_TOKENS=2048

# Sent only to the grader, and only when the active provider supports it.
# Leave unset to send nothing; "none" is not a valid value and was previously
# sent on every grader call by default.
# LLM_REASONING_EFFORT=

# Page renders attached to each request, downscaled before upload. The answer role
# attaches up to LLM_MAX_PAGES images and the grader attaches 2, so this must fit
# the active model's multimodal limit or /chat fails with a config error.
# groq/qwen3.8-27b allows 3, so use 3 with groq. The default of 5 suits euron.
# LLM_MAX_PAGES=5
# LLM_IMAGE_MAX_EDGE=768
# LLM_IMAGE_QUALITY=70

# --- Self-RAG (RAG_*) ---
# RAG_TOP_K=5
# RAG_RELEVANCE_THRESHOLD=0.35
# RAG_MAX_REWRITES=2

# --- HTTP API (API_*) ---
# No authentication; keep bound to loopback.
# API_HOST=127.0.0.1
# API_PORT=8000
# Defaults to the local Vite dev server origins. Override this when the frontend
# is hosted elsewhere.
# API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging ---
# LOG_LEVEL=INFO
