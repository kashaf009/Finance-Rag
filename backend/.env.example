# Copy to `.env` and fill in real values. Never commit `.env`.

# --- LLM providers (OpenAI-compatible via langchain-openai) ---
GROQ_API_KEY=
GROK_BASEURL=https://api.groq.com/openai/v1

EURON_API_KEY=
EURI_BASE_URL=https://api.euron.one/api/v1/euri

# --- Gemini embeddings (google-genai) ---
GOOGLE_API_KEY=

# --- Paths ---
# STORAGE_DIR=
# DOCS_DIR=
# POPPLER_PATH=/opt/homebrew/bin

# --- PDF rendering (RENDER_*) ---
# RENDER_SOURCE_DPI=200
# RENDER_MEASURE_DPI=50
# RENDER_COLORSPACE=rgb
# RENDER_TRIM=true
# RENDER_CHUNK_PAGES=8
# RENDER_THREAD_COUNT=4
# RENDER_EXTRACT_TEXT=true

# --- Image normalization (IMAGE_*) ---
# IMAGE_NORMALIZE_MODE=trim_fit_uniform
# IMAGE_TARGET_W=1024
# IMAGE_TARGET_H=1408
# IMAGE_RESAMPLE=lanczos
# IMAGE_ALLOW_UPSCALE=false
# IMAGE_MAX_PIXELS=4000000
# IMAGE_JPEG_QUALITY=85
# IMAGE_JPEG_OPTIMIZE=true
# IMAGE_PAD_COLOR=ffffff

# --- Qdrant (docker compose up -d qdrant) ---
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=finance_pages
# QDRANT_TIMEOUT=60.0

# --- Gemini embeddings (EMBED_*) ---
# EMBED_MODEL=gemini-embedding-2
# EMBED_DIM=1024
# EMBED_WORKERS=4
# EMBED_RETRIES=3
# EMBED_RETRY_DELAY=2.0
# EMBED_DOCUMENT_TASK=RETRIEVAL_DOCUMENT
# EMBED_QUERY_TASK=RETRIEVAL_QUERY

# --- Generative LLM (LLM_*) ---
# Uses EURON_API_KEY + EURI_BASE_URL above.
# LLM_MODEL=gemini-2.5-flash
# LLM_GRADER_MODEL=gemini-2.5-flash
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT=120.0
# LLM_MAX_RETRIES=3
# LLM_MAX_COMPLETION_TOKENS=2048
# LLM_REASONING_EFFORT=none
# Prompt images are downscaled before upload:
# LLM_MAX_PAGES=5
# LLM_IMAGE_MAX_EDGE=768
# LLM_IMAGE_QUALITY=70

# --- Self-RAG (RAG_*) ---
# RAG_TOP_K=5
# RAG_RELEVANCE_THRESHOLD=0.35
# RAG_MAX_REWRITES=2

# --- HTTP API (API_*) ---
# No authentication; keep bound to loopback.
# API_HOST=127.0.0.1
# API_PORT=8000
# API_CORS_ORIGINS=http://localhost:5173

# --- Logging ---
# LOG_LEVEL=INFO
